# Copia este archivo como .env (nunca lo subas al repositorio)
# Los valores se obtienen en Supabase > Project Settings

# API HTTPS (Auth, Storage y clientes)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Postgres directo para el backend (Skunk) — Sprint 1
# Codifica caracteres especiales de la contraseña (@, :, /, #, ?, %) con percent-encoding.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Backend
PORT=8080
